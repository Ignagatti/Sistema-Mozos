    "productName": "Sistema de Gestión para Mozos",
    "win": {
      "target": "nsis",
      "icon": "icono.ico"
    }
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.0.0"
  }
}
