{
  "name": "sistema-gestion-mozos-v2",
  "version": "1.0.0",
  "description": "Sistema de gestión de mesas y pedidos para mozos",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win nsis",
    "test": "node tests/calculations.test.js && node tests/sales-report.test.js && node tests/edge-cases-and-stress.test.js"
  },
  "build": {
    "appId": "com.tuempresa.gestionmozos.v2",
    "productName": "Sistema de Gestión para Mozos V2",
    "win": {
      "target": "nsis",
      "icon": "assets/logo_rivera.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Sistema de Gestión para Mozos V2",
      "installerIcon": "assets/logo_rivera.ico",
      "uninstallerIcon": "assets/logo_rivera.ico",
      "uninstallDisplayName": "Sistema de Gestión para Mozos V2",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true
    },
    "files": [
      "**/*",
      "!dist/*",
      "!tests/*"
    ]
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.0.0"
  },
  "dependencies": {
    "dotenv": "^18.0.5",
    "pg": "^8.23.1"
  }
}
